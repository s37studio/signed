{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd apps/mcp && bun install --production && bun build src/index.ts --compile --outfile mcp-server",
    "watchPatterns": [
      "apps/mcp/**"
    ]
  },
  "deploy": {
    "startCommand": "apps/mcp/mcp-server",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
