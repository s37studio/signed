generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

enum ProposalStatus {
  PENDING
  WON
  LOST
  REVISION
}

// ─── Better Auth — Organization plugin ───────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     Member[]
  invitations Invitation[]
  leads       Lead[]
  proposals   Proposal[]
  mcpApiKeys  McpApiKey[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("member")
  status         String       @default("pending")
  expiresAt      DateTime?
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ─── App models ───────────────────────────────────────────────────────────────

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  company   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  proposals      Proposal[]

  @@index([organizationId])
  @@index([createdById])
  @@map("lead")
}

model Proposal {
  id              String         @id @default(cuid())
  title           String
  templateId      String
  customData      Json
  price           Float          @default(0)
  password        String?
  token           String         @unique
  slug            String
  status          ProposalStatus @default(PENDING)
  revisionMessage String?
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sentAt       DateTime?
  openedAt     DateTime?
  lastOpenedAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  views       ProposalView[]

  @@index([organizationId])
  @@index([leadId])
  @@index([createdById])
  @@index([token])
  @@map("proposal")
}

model McpApiKey {
  id             String       @id @default(cuid())
  keyHash        String       @unique
  name           String
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?

  @@index([keyHash])
  @@index([userId])
  @@map("mcp_api_key")
}

model ProposalView {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  viewedAt  DateTime @default(now())
  duration  Int?
  
  ipAddress String?
  city      String?
  country   String?
  region    String?

  @@index([proposalId])
  @@index([viewedAt])
  @@map("proposal_view")
}
